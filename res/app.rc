#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

IDI_APP       ICON    "app.ico"
IDR_ICON_PNG  RCDATA  "icon_ui.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", "loveyourvoice"
            VALUE "FileDescription", "RDP Cert Fix - ремонт сертификата RDP при КриптоПро"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "rdp-cert-fix"
            VALUE "OriginalFilename", "rdp-cert-fix.exe"
            VALUE "ProductName", "RDP Cert Fix"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
